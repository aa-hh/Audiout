+    // MARK: - Per-app Bluetooth routing (R-partition, per-app half)
+    //
+    // A route naming a Bluetooth id is fed by UID through the sink manager
+    // (`btPerAppClaimedUIDs`/`setPerAppClaimedUIDs`), armed independently of
+    // any whole-system selection (`btArmingLocked`) — but the room's timing
+    // (`btReferenceBufferMs`) stays a function of the whole-system selection
+    // ALONE: a per-app-only speaker reads the room's clock, never sets it.
+
+    /// A per-app-only route arms the sink and hands its uid to BOTH the
+    /// device set and the whole-system fan-out's skip list with NOTHING
+    /// selected whole-system, and an unrelated whole-system BT selection
+    /// composes with it rather than evicting it from the device set.
+    @Test func perAppOnlyBTRouteArmsSinkAndComposesWithAnUnrelatedWholeSystemSelection() {
+        let perAppCapture = workingPerAppCapture(bundleIDs: ["com.foo"])
+        let (backend, engine, _, bt, sink, _) = makeBackend(injectedPerAppCapture: perAppCapture)
+        defer { backend.stop() }
+        backend.start()
+        bt.fire([btMove, btFlip])
+        waitFor { self.device(backend, self.btMove.id) != nil && self.device(backend, self.btFlip.id) != nil }
+
+        backend.updateAppRoutes([route("com.foo", name: "Foo", toDevice: btMove.id)])
+        waitFor { sink.perAppClaimedUIDCalls.last == [self.btMove.id] }
+        #expect(sink.calls.contains("start"),
+                "a per-app-only claim arms the sink with no whole-system selection")
+        #expect(sink.deviceSets.last?.map(\.uid) == [btMove.id],
+                "the claimed uid reaches the device set even with nothing selected whole-system")
+        #expect(sink.perAppClaimedUIDCalls.last == [btMove.id],
+                "the claimed uid reaches the whole-system fan-out's skip list")
+
+        backend.setOutputSet([btFlip.id])
+        waitFor { sink.deviceSets.last?.map(\.uid).sorted() == [self.btFlip.id, self.btMove.id].sorted() }
+        #expect(sink.deviceSets.last?.map(\.uid).sorted() == [btFlip.id, btMove.id].sorted(),
+                "an unrelated whole-system selection must not evict the per-app claim from the device set")
+        #expect(engine.addedIDs.isEmpty, "no BT id may ever reach the AirPlay engine")
+    }
+
+    /// The CONTESTED case: the same device is BOTH whole-system selected AND
+    /// per-app routed. `isRouteTargetEligibleLocked` is
+    /// `isRouteTargetReachableLocked(id) && !isWholeSystemClaimedLocked(id)`,
+    /// and `isWholeSystemClaimedLocked` reads `expectedSelected`, which
+    /// `setOutputSet` fills with every selected id regardless of kind — so the
+    /// per-app route is demoted before it can ever claim the speaker. Were it
+    /// not, the speaker would be pulled out of the whole-system fan-out and go
+    /// silent for every consumer but the one app routed to it.
+    @Test func perAppRouteToAWholeSystemSelectedBTDeviceNeverClaimsItAwayFromTheFanOut() {
+        let perAppCapture = workingPerAppCapture(bundleIDs: ["com.foo"])
+        let (backend, engine, _, bt, sink, _) = makeBackend(injectedPerAppCapture: perAppCapture)
+        defer { backend.stop() }
+        backend.start()
+        bt.fire([btMove])
+        waitFor { self.device(backend, self.btMove.id) != nil }
+
+        backend.setOutputSet([btMove.id])
+        waitFor { sink.calls.contains("start") }
+
+        backend.updateAppRoutes([route("com.foo", name: "Foo", toDevice: btMove.id)])
+        waitFor { backend.test_scopeConflict(deviceID: self.btMove.id) != nil }
+
+        #expect(backend.test_scopeConflict(deviceID: btMove.id)?.bundleIDs == ["com.foo"],
+                "the route to an already-selected speaker must be demoted, not accepted")
+        #expect(!sink.perAppClaimedUIDCalls.contains { $0.contains(btMove.id) },
+                "a whole-system-claimed uid must never reach the per-app claim set")
+        #expect(sink.deviceSets.last?.map(\.uid).contains(btMove.id) == true,
+                "the speaker must stay in the whole-system device set, not drop out for being contested")
+        #expect(engine.addedIDs.isEmpty, "no BT id may ever reach the AirPlay engine")
+    }
+
+    /// The mirror case: with no whole-system BT ever selected, clearing the
+    /// app's only route drops its uid from both the device set and the claim
+    /// set, and disables the manager entirely.
+    @Test func clearingTheOnlyPerAppBTRouteDropsTheClaimAndDisablesTheSink() {
+        let perAppCapture = workingPerAppCapture(bundleIDs: ["com.foo"])
+        let (backend, engine, _, bt, sink, _) = makeBackend(injectedPerAppCapture: perAppCapture)
+        defer { backend.stop() }
+        backend.start()
+        bt.fire([btMove])
+        waitFor { self.device(backend, self.btMove.id) != nil }
+
+        backend.updateAppRoutes([route("com.foo", name: "Foo", toDevice: btMove.id)])
+        waitFor { sink.perAppClaimedUIDCalls.last == [self.btMove.id] }
+
+        backend.updateAppRoutes([])
+        waitFor { sink.perAppClaimedUIDCalls.last?.isEmpty == true }
+        #expect(sink.calls.contains("stop"),
+                "no whole-system BT selected ⇒ clearing the only per-app claim disables the manager")
+        #expect(sink.deviceSets.last?.isEmpty == true, "the uid drops out of the device set")
+        #expect(sink.perAppClaimedUIDCalls.last?.isEmpty == true, "the uid drops out of the claim set")
+        #expect(engine.addedIDs.isEmpty, "no BT id may ever reach the AirPlay engine")
+    }
+
+    /// Owner decision: per-app destinations READ the room's timing, never SET
+    /// it. A per-app-only speaker's own measured latency — however large —
+    /// must never raise the shared BT reference every other speaker, the
+    /// Mac's own sink, and the AirPlay pre-delay are scheduled against; and
+    /// the composition the per-app arm hands the sink stays exactly what the
+    /// whole-system selection produced.
+    @Test func perAppOnlyLatencyNeverRaisesTheSharedReference() {
+        let perAppCapture = workingPerAppCapture(bundleIDs: ["com.foo"])
+        let (backend, _, _, bt, sink, _) = makeBackend(injectedPerAppCapture: perAppCapture)
+        defer { backend.stop() }
+        backend.start()
+        bt.fire([btMove, btFlip])
+        waitFor { self.device(backend, self.btMove.id) != nil && self.device(backend, self.btFlip.id) != nil }
+
+        // btFlip is the WHOLE-SYSTEM selection — it alone decides
+        // `btSinkEnabled` and the composition; btMove is per-app-only.
+        backend.setOutputSet([btFlip.id])
+        waitFor { sink.calls.contains("start") }
+
+        backend.updateAppRoutes([route("com.foo", name: "Foo", toDevice: btMove.id)])
+        waitFor { sink.deviceSets.last?.map(\.uid).sorted() == [self.btFlip.id, self.btMove.id].sorted() }
+
+        // Seed a measured latency for the per-app-only device that would blow
+        // straight through the default reference if it were ever allowed to
+        // count — seeded the way the existing suite does.
+        backend.endBTWizardLatencyPreview(forDevice: btMove.id, keepMs: 900)
+        waitFor { backend.btMeasuredLatencyMs(forDevice: self.btMove.id) == 900 }
+        waitFor(timeout: 0.3) { false }   // let the async reference recompute settle
+
+        #expect(backend.localSinkReferenceDelayMs() == BTSyncedSink.defaultBTOnlyBufferMs,
+                "a per-app-only device's latency must never raise the shared BT reference")
+        #expect(sink.compositions.last == BTGroupComposition(airPlayPresent: false, macLocalPresent: false),
+                "the per-app arm hands the sink exactly the composition whole-system selection produced")
+    }
+
+    /// Full-chain delivery (T10-style harness, per-suite doubles): a real
+    /// captured buffer pushed through `PerAppCaptureCoordinator` ->
+    /// `AppRouteMixer` reaches the Bluetooth sink through the UID-scoped
+    /// `enqueue`, addressed to exactly the routed device — and a second BT
+    /// device that is whole-system selected but never per-app routed gets
+    /// nothing through that path (the routing-partition invariant, end to end).
+    @Test func perAppRoutedBTDeviceReceivesFramesThroughTheUIDScopedPath() {
+        let registry = TapRegistry()
+        let perAppCapture = registeringPerAppCapture(muteBehavior: .mutedWhenTapped, bundleIDs: ["com.foo"], into: registry)
+        let (backend, _, _, bt, sink, _) = makeBackend(injectedPerAppCapture: perAppCapture)
+        defer { backend.stop() }
+        backend.start()
+        bt.fire([btMove, btFlip])
+        waitFor { self.device(backend, self.btMove.id) != nil && self.device(backend, self.btFlip.id) != nil }
+
+        // btFlip: whole-system selected, never per-app routed — the negative.
+        backend.setOutputSet([btFlip.id])
+        waitFor { sink.calls.contains("start") }
+
+        backend.updateAppRoutes([route("com.foo", name: "Foo", toDevice: btMove.id)])
+        waitFor { if case .capturing = perAppCapture.state(for: "com.foo") { return true }; return false }
+        guard let tap = registry.tap(for: "com.foo") else {
+            Issue.record("the routed app's per-app tap must have registered")
+            return
+        }
+
+        tap.push(fingerprintedBuffer(fill: 0xAA, frames: 1000, atSecond: 1))
+
+        waitFor { !sink.perAppEnqueues.isEmpty }
+        #expect(sink.perAppEnqueues.contains { $0.uids == [btMove.id] && $0.frameCount > 0 },
+                "the per-app mixed stream must reach the BT sink through the UID-scoped enqueue")
+        #expect(!sink.perAppEnqueues.contains { $0.uids.contains(btFlip.id) },
+                "a whole-system-only BT device must never receive frames through the UID-scoped per-app path")
+    }
 }

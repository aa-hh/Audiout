<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SMAppService launchd daemon plist for the ptp-helper binary (T3,
     AirPlayEngine/docs/ptp-helper-design.md §2.2/§2.4). scripts/make-app.sh
     substitutes the placeholder token below (BUNDLE underscore ID, doubled
     underscores each side) with the app's actual BUNDLE_ID (default
     com.audiout.Audiout) before copying into
     Contents/Library/LaunchDaemons/ — the filename there MUST equal Label +
     ".plist" (SMAppService.daemon(plistName:) resolves the plist by that
     exact name). Label/AssociatedBundleIdentifiers are BUNDLE_ID-derived (not
     hardcoded) so a side-by-side dev build under a distinct BUNDLE_ID gets its
     own independently-registerable daemon identity rather than colliding with
     another Audiout copy's already-claimed "com.audiout.Audiout.ptphelper"
     label (2026-07-24 live-testing bug — two copies silently fought over one
     daemon identity, and the loser's register() silently no-op'd instead of
     throwing). The MachServices/EnvironmentVariables tokens below are
     substituted by the same global sed pass, so they carry the same
     per-BUNDLE_ID isolation — and so is the helper's embedded Info.plist,
     scripts/ptp-helper-info.plist, whose CFBundleIdentifier carries the same
     token (it hardcoded the default label until 2026-09-07, so every
     non-default build shipped a helper whose embedded identity named another
     daemon's Label). Never edit either in place without mirroring the
     substitution in make-app.sh; scripts/verify-bundle.sh refuses a build
     whose embedded identifier and Label disagree.

     On-demand shape (T3): the helper no longer runs from boot. RunAtLoad is
     gone and KeepAlive is scoped to SuccessfulExit=false — launchd respawns
     only a crash (non-zero exit); a clean exit 0 (idle exit / bind give-up,
     see main.c's exit-code contract) is left down, not fought back up.
     MachServices registers the helper under a Mach service name launchd
     starts on demand, the first time the app actually connects to it — no
     always-on root process for a feature the user may never invoke this
     session. EnvironmentVariables hands the helper that same service name
     (AUDIOUT_PTP_MACH_SERVICE) so it knows which name to check in on; unset
     (dev path, run outside launchd) means no check-in at all.

     AUDIOUT_PTP_PEER_REQUIREMENT carries a second placeholder token (TEAM
     underscore ID, doubled underscores each side), alongside the bundle-id
     one above: make-app.sh derives it from the Developer ID signing
     identity's Team ID and substitutes both into the requirement string
     below, which is the app's own designated requirement. An ad-hoc build
     (no Developer ID identity, so no Team ID) renders this value as an
     empty string, which makes the helper refuse every release request and
     rely on idle exit alone. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__BUNDLE_ID__.ptphelper</string>

    <key>BundleProgram</key>
    <string>Contents/MacOS/ptp-helper</string>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>MachServices</key>
    <dict>
        <key>__BUNDLE_ID__.ptphelper</key>
        <true/>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>AUDIOUT_PTP_MACH_SERVICE</key>
        <string>__BUNDLE_ID__.ptphelper</string>

        <key>AUDIOUT_PTP_PEER_REQUIREMENT</key>
        <string>identifier "__BUNDLE_ID__" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] and certificate leaf[field.1.2.840.113635.100.6.1.13] and certificate leaf[subject.OU] = "__TEAM_ID__"</string>
    </dict>

    <key>AssociatedBundleIdentifiers</key>
    <string>__BUNDLE_ID__</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>

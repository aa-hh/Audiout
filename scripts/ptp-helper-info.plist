<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist embedded into the ptp-helper Mach-O via a `-sectcreate __TEXT
  __info_plist` linker section (see scripts/make-app.sh). SMAppService requires a
  standalone-executable LaunchDaemon to carry an embedded Info.plist with a
  CFBundleIdentifier; without it, register() will not launch the daemon
  (ptp-helper-design.md §2.2). CFBundleIdentifier MUST match the daemon's Label
  (com.audiouter.Audiouter.ptphelper) and the LaunchDaemons plist filename.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.audiouter.Audiouter.ptphelper</string>
    <key>CFBundleName</key>
    <string>ptp-helper</string>
    <key>CFBundleExecutable</key>
    <string>ptp-helper</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
</dict>
</plist>

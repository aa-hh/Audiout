<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened-runtime entitlements. See scripts/make-app.sh for full rationale.
         disable-library-validation is TRUE: bundled dylibs are re-signed ad-hoc
         (no Team ID), so library validation would reject them. Developer ID would
         allow re-enabling. DYLD_INSERT protection comes from hardened runtime +
         keeping allow-dyld-environment-variables FALSE, not library validation.
         Never set those to true. Avoid two-hyphen sequences; AMFI rejects them. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <false/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>
    <key>com.apple.security.cs.allow-jit</key>
    <false/>
    <!-- Bluetooth (BT-CONNECT, PLAN-UNIVERSAL-SYNC section K). This key is
         App-Sandbox-scoped, so it is inert while the app ships unsandboxed;
         the runtime gate that actually matters today is the Bluetooth TCC
         grant via NSBluetoothAlwaysUsageDescription (see make-app.sh). Listed
         now so a future sandbox adoption cannot silently strip IOBluetooth. -->
    <key>com.apple.security.device.bluetooth</key>
    <true/>
    <!-- Microphone (roadmap 064, mic-probe alignment measurement). Same
         posture as Bluetooth above: App-Sandbox-scoped and inert unsandboxed —
         the live gate is the mic TCC prompt via NSMicrophoneUsageDescription
         (make-app.sh). Listed so a future sandbox adoption cannot silently
         strip the built-in-mic capture. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>

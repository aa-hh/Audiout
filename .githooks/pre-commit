#!/bin/sh
# Two guards, in order of how much they matter.
#
# Enable with:  git config core.hooksPath .githooks
# Disable with: git config --unset core.hooksPath
# Override once: git commit --no-verify

git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0
hook_dir=$(dirname "$0")

# ---------------------------------------------------------------------------
# GUARD 1 (BLOCKING): no direct commits onto main.
#
# This is the one that would have prevented this repo's worst failure. f1f3e94
# put a whole feature's docs on main with none of its code — and NOT because
# anyone decided to. Someone had been editing AGENTS.md directly in the main
# checkout; those loose edits then BLOCKED an unrelated agent's merge, and that
# agent committed the mess it found in order to unblock itself. It had no idea
# the matching code was sitting in a third session's worktree, about to be
# stashed and forgotten. Loose edits in a shared checkout are a trap for the
# next agent through, and the trap is that committing them looks helpful.
#
# So: don't work in the main checkout. Work in a worktree, where docs and code
# have to travel together as one merge.
#
# Merges are deliberately exempt, and this is verified behaviour, not a guess:
#   - a clean `git merge` never invokes pre-commit at all
#   - a conflict-resolution merge commit DOES invoke it, but has MERGE_HEAD
# So merging a branch into main — the correct way to land anything — is
# untouched. Only typing `git commit` while standing on main is refused.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] && [ ! -f "$git_dir/MERGE_HEAD" ]; then
    echo "" >&2
    echo "  REFUSED: direct commit to main." >&2
    echo "" >&2
    echo "  Work in a worktree and merge it in — that is how docs and code stay" >&2
    echo "  together. Committing straight to main is how f1f3e94 shipped a" >&2
    echo "  feature's docs with none of its code, and cost a whole session to" >&2
    echo "  recover. See the hard rule in AGENTS.md." >&2
    echo "" >&2
    echo "  Merging a branch into main is NOT affected by this — only a bare" >&2
    echo "  'git commit' on main is." >&2
    echo "" >&2
    echo "  If these are someone else's uncommitted edits and they are in your" >&2
    echo "  way: STOP and ask. Do not commit work you did not write — that is" >&2
    echo "  precisely the mistake that caused the incident." >&2
    echo "" >&2
    echo "  Really meant it?  git commit --no-verify" >&2
    echo "" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# GUARD 2 (WARN-ONLY): AGENTS.md must not name symbols this commit lacks.
#
# Catches what Guard 1 cannot: a name that was wrong the moment it was written
# (d033466 documented setAppRoute/setAppVolume/removeAppRoute in the very same
# commit whose code declared addRoute/setDestination/setVolume/removeRoute), and
# a doc left stale after code was deleted. Neither is a save-order mistake, so
# no amount of branch discipline touches them.
#
# Missing checker or no python3 => silently skip. A hook that errors out on an
# unrelated machine is worse than a hook that isn't there.
checker="$hook_dir/agents-md-symbol-check.py"
if [ -f "$checker" ] && command -v python3 >/dev/null 2>&1; then
    python3 "$checker" || true
fi

# ---------------------------------------------------------------------------
# GUARD 8 (BLOCKING): don't re-create audiout-shared's public types locally.
#
# SyncProbeCorrelator was hand-copied from audiout-shared into a consumer
# repo once already and drifted silently — nothing mechanical stopped it.
# Positioned here, early and cheap (a name/grep scan, no build), so a leak is
# caught before the slow test guards run. Logic lives in
# guard-shared-leak.sh, same split as Guard 2's checker. Missing helper =>
# silently skip, same principle as Guard 2.
g8="$hook_dir/guard-shared-leak.sh"
if [ -f "$g8" ]; then
    sh "$g8" || exit 1
fi

# ---------------------------------------------------------------------------
# GUARD 3 (WARN-ONLY): new test code must not reach cross-process shared state.
#
# `swift test --parallel --num-workers 4` (the default full-run command — see
# AudioutCore/AGENTS.md) runs each test CLASS in its own process. Processes
# share nothing in memory, but they DO share `UserDefaults.standard` (one
# on-disk plist) and a fixed `FileManager.default.temporaryDirectory` path. Two
# suites writing the same defaults key or temp filename race and flake. The
# blessed fix is to subclass `IsolatedTestCase` (Tests/AudioutCoreTests/
# IsolatedTestCase.swift) and use `scratchDir` / `isolatedDefaults` /
# `makeDefaults()` / `uniqueName(_:)` instead of the shared globals.
#
# `UserDefaults(suiteName:)` is flagged too, for a different reason: it isolates
# correctly but every distinct name is a permanent `~/Library/Preferences` plist
# nothing can delete afterwards (see `InMemoryDefaults`) — measured at 48,769
# files / 200 MB on one machine.
#
# This scans only the ADDED lines of staged test files, so it never nags about
# pre-existing code — only newly introduced reaches. A line that genuinely must
# touch a global (e.g. AppKit's `setFrameAutosaveName`, which always writes
# `.standard`) is exempted with a trailing `isolation-ok` comment.
staged_tests=$(git diff --cached --name-only --diff-filter=AM -- '*Tests*.swift' 2>/dev/null)
iso_hits=""
for f in $staged_tests; do
    case "$f" in */IsolatedTestCase.swift) continue ;; esac
    added=$(git diff --cached -U0 -- "$f" 2>/dev/null | grep -E '^\+[^+]')
    bad=$(printf '%s\n' "$added" \
        | grep -Ei 'UserDefaults\.standard|UserDefaults\(suiteName:|FileManager\.default\.temporaryDirectory' \
        | grep -vi 'isolation-ok')
    if [ -n "$bad" ]; then
        iso_hits="$iso_hits\n  $f:\n$(printf '%s\n' "$bad" | sed 's/^+/    /')"
    fi
done
if [ -n "$iso_hits" ]; then
    echo "" >&2
    echo "  NOTE (non-blocking): new test lines reach cross-process shared state." >&2
    echo "  Under 'swift test --parallel' these can flake. Prefer subclassing" >&2
    echo "  IsolatedTestCase and using scratchDir / isolatedDefaults / uniqueName()." >&2
    printf "%b\n" "$iso_hits" >&2
    echo "" >&2
    echo "  If a line truly must touch a global (e.g. AppKit setFrameAutosaveName)," >&2
    echo "  append a trailing 'isolation-ok' comment to silence this." >&2
    echo "" >&2
fi

# ---------------------------------------------------------------------------
# GUARD 7 (BLOCKING): staged Swift must pass the readability self-review.
#
# Numbered by arrival like every guard, but positioned HERE — before the
# test-suite guards — so a review bounce costs seconds, not a full suite run.
# Logic lives in guard-self-review.sh (same split as Guard 2's checker):
# a deterministic screen over added comment lines, then a receipt proving
# scripts/self-review.sh ran against these exact staged bytes. Rubric and
# rationale: docs/REVIEW-RUBRIC.md. Missing helper => silently skip, same
# principle as Guard 2 — a hook that errors on an unrelated machine is worse
# than a hook that isn't there.
g7="$hook_dir/guard-self-review.sh"
if [ -f "$g7" ]; then
    sh "$g7" || exit 1
fi

# ---------------------------------------------------------------------------
# GUARD 4 (BLOCKING): the full test suite must pass before Swift code is
# committed. THE coverage guarantee — nothing broken gets committed, and since
# everything that reaches main was committed here first, main stays green.
#
# Agents may run `swift test --filter <Suite>` while iterating (fast); a
# too-narrow filter can miss a suite the change broke, but that risk is absorbed
# HERE — no commit touching AudioutCore Swift sources/tests lands until the
# WHOLE suite (parallelised) passes. So filtering can only ever cost one extra
# fix cycle at commit time.
#
# Scope: only runs when staged files include AudioutCore Swift source/test
# files. Docs/config/other commits skip it (no code changed → nothing to gate).
#
# Pathspec note: a bare directory pathspec + `grep '\.swift$'` — NOT
# `Sources/**/*.swift`, whose `**` must span ≥1 directory and so silently
# misses a file sitting directly in Sources/ or Tests/ (verified empirically).
#
# Escape hatch: `git commit --no-verify` for a deliberate emergency, same as
# the other guards. Missing `swift` toolchain => skip (don't wedge a machine
# that can't build).
staged_swift=$(git diff --cached --name-only --diff-filter=ACM -- \
    'AudioutCore/Sources/' 'AudioutCore/Tests/' 2>/dev/null | grep '\.swift$')
if [ -n "$staged_swift" ] && command -v swift >/dev/null 2>&1; then
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
    echo "" >&2
    echo "  Guard 4: AudioutCore Swift changed — running full suite" >&2
    echo "  (scripts/run-tests.sh) before commit. ~70s warm; --no-verify to skip." >&2
    # Via the shared runner, NOT a bare `swift test`: the runner takes a
    # machine-wide lock so concurrent agents queue instead of thrashing 8 cores
    # with N full suites at once, and skips the run outright when these exact
    # sources already passed. It hashes the WORKING TREE, which is what this
    # guard has always actually tested (it never stashed unstaged changes).
    # Finding the runner, in priority order. This matters more than it looks:
    # core.hooksPath is an ABSOLUTE path to the primary checkout's .githooks, so
    # EVERY worktree executes THIS file — but $repo_root/scripts/run-tests.sh
    # resolves to each worktree's OWN root, and a branch cut before this work has
    # no such file there. Preferring only $repo_root would mean the runner
    # silently did nothing for every in-flight worktree (11 of 12 when this
    # landed) until each merged main, which is exactly the case where the
    # machine-wide cap is needed most.
    #
    # So: this worktree's copy first (a branch may legitimately be iterating on
    # the runner itself and must test its own version), else the copy that sits
    # beside this hook in the primary checkout — the same checkout git already
    # points every worktree at. The runner derives its own repo_root from the
    # invoking cwd, so main's copy operates correctly on the calling worktree.
    hook_root=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)
    if [ -x "$repo_root/scripts/run-tests.sh" ]; then
        run_suite="$repo_root/scripts/run-tests.sh"
    elif [ -n "$hook_root" ] && [ -x "$hook_root/scripts/run-tests.sh" ]; then
        run_suite="$hook_root/scripts/run-tests.sh"
    else
        echo "  (no scripts/run-tests.sh found — running unserialised)" >&2
        run_suite=""
    fi
    # --build-system native matches scripts/run-tests.sh and scripts/make-app.sh
    # — see the long note at run-tests.sh's `swift test` call. The engines keep
    # separate cache trees, so a guard that disagreed with the runner would make
    # every commit pay a cold rebuild.
    if ! { if [ -n "$run_suite" ]; then "$run_suite"; \
           else ( cd "$repo_root/AudioutCore" && swift test --build-system native --parallel --num-workers 4 >&2 ); fi; }; then
        echo "" >&2
        echo "  REFUSED: full test suite failed. Fix the failures" >&2
        echo "  (or 'git commit --no-verify' for a real emergency)." >&2
        echo "" >&2
        exit 1
    fi
    echo "  Guard 4: full suite passed." >&2
fi

# ---------------------------------------------------------------------------
# GUARD 5 (WARN-ONLY): don't backslide new tests onto XCTest.
#
# The XCTest -> swift-testing migration
# (docs/notes/swift-testing-conversion-cookbook.md) is done for the large
# majority of both AudioutCore's and AirPlayEngine's test suites. New tests
# should be written `import Testing` / `@Suite` / `@Test`, not `import XCTest`.
#
# This only fires on a newly ADDED `import XCTest` line (diffs the STAGED
# content with `git diff --cached -U0`, same technique as Guard 3), so it never
# nags about a file's pre-existing `import XCTest` — e.g.
# `IsolatedTestCase.swift`'s legacy XCTest base, which legitimately still has
# one, or any not-yet-converted file — unless someone is actively re-adding a
# line there. Warn-only: this repo's migration was never enforced with a
# blocking gate, so backsliding away from it shouldn't be either. It just needs
# to be visible so it doesn't happen quietly.
staged_swift_pkgs=$(git diff --cached --name-only --diff-filter=AM -- \
    'AudioutCore/' 'AirPlayEngine/' 2>/dev/null | grep '\.swift$')
xctest_hits=""
for f in $staged_swift_pkgs; do
    added=$(git diff --cached -U0 -- "$f" 2>/dev/null | grep -E '^\+[^+]')
    bad=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*import XCTest\b')
    if [ -n "$bad" ]; then
        xctest_hits="$xctest_hits\n  $f"
    fi
done
if [ -n "$xctest_hits" ]; then
    echo "" >&2
    echo "  WARNING (non-blocking): new 'import XCTest' line(s) staged." >&2
    echo "  The XCTest -> swift-testing migration is complete for the large" >&2
    echo "  majority of this repo's suites. New tests should use" >&2
    echo "  'import Testing' / '@Suite' / '@Test' instead — see" >&2
    echo "  docs/notes/swift-testing-conversion-cookbook.md." >&2
    printf "%b\n" "$xctest_hits" >&2
    echo "" >&2
fi

# ---------------------------------------------------------------------------
# GUARD 6 (BLOCKING): AirPlayEngine's own test suite must pass before its
# Swift code is committed.
#
# AirPlayEngine is a standalone SwiftPM package (sibling of, not nested in,
# AudioutCore — see AirPlayEngine/AGENTS.md), so Guard 4's AudioutCore run
# never touches it: a commit that only changes AirPlayEngine currently gets no
# automatic test run at all. This closes that gap with an independent guard —
# deliberately NOT folded into Guard 4, so an AudioutCore-only commit never
# pays for an AirPlayEngine run it didn't need, and vice versa. A commit
# touching both packages runs both suites.
#
# AirPlayEngine's suite is small (~144 tests, ~2s) — no lock/queue/pass-cache
# machinery like scripts/run-tests.sh; a plain `swift test` inline is fast
# enough that the machinery would cost more than it saves.
#
# Escape hatch: `git commit --no-verify`, same as Guard 4. Missing `swift`
# toolchain => skip.
staged_airplayengine=$(git diff --cached --name-only --diff-filter=ACM -- \
    'AirPlayEngine/Sources/' 'AirPlayEngine/Tests/' 2>/dev/null | grep '\.swift$')
if [ -n "$staged_airplayengine" ] && command -v swift >/dev/null 2>&1; then
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
    echo "" >&2
    echo "  Guard 6: AirPlayEngine Swift changed — running its test suite" >&2
    echo "  before commit. ~2s; --no-verify to skip." >&2
    if ! ( cd "$repo_root/AirPlayEngine" && swift test --build-system native >&2 ); then
        echo "" >&2
        echo "  REFUSED: AirPlayEngine test suite failed. Fix the failures" >&2
        echo "  (or 'git commit --no-verify' for a real emergency)." >&2
        echo "" >&2
        exit 1
    fi
    echo "  Guard 6: AirPlayEngine suite passed." >&2
fi

exit 0

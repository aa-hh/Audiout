+    /// The production browser cannot learn a service's mDNS host (it passes the
+    /// Bonjour instance name), so the self-receiver filter also drops a service
+    /// whose resolved address is one of this Mac's own interface addresses, for
+    /// both service types. Ordering on the discovery queue makes the single
+    /// .appeared event prove the self resolves produced nothing.
+    /// Turns red if handleResolve stops comparing a service's resolved address with this Mac's own interface addresses.
+    @Test func selfAddressServicesAreNeverSurfaced() {
+        let browser = FakeBrowser()
+        let discovery = makeDiscovery(browser: browser, localHostname: "my-test-mac.local",
+                                      localAddresses: ["192.168.1.20"])
+        let events = EventCollector()
+        discovery.onEvent = { events.append($0) }
+        discovery.start()
+
+        browser.resolve(airplayService(id: "EE:CF:9C:BE:22:88", name: "My Test Mac",
+                                       features: ap2Features, address: "192.168.1.20"))
+        browser.resolve(raopService(id: "EE:CF:9C:BE:22:88", name: "EECF9CBE2288@My Test Mac",
+                                    address: "192.168.1.20"))
+        browser.resolve(airplayService(id: "AA:BB:CC:DD:EE:07", name: "Real Speaker",
+                                       features: ap2Features))
+
+        let received = events.wait(count: 1)
+        guard case .appeared(let device)? = received.first else {
+            Issue.record("expected exactly the real speaker's .appeared, got \(received)")
+            return
+        }
+        #expect(device.id == "AA:BB:CC:DD:EE:07",
+                "only the non-self address surfaced; the self receiver produced no event")
+        #expect(discovery.devices.map(\.id) == ["AA:BB:CC:DD:EE:07"],
+                "the self receiver never entered the known set either")
+    }

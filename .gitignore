.DS_Store
*.swp

# Assembled .app bundle from scripts/make-app.sh (build artifact).
build/

# OwnTone spike build (Phase 0 dev/test server) — durable local dev artifact,
# not part of the shipped app; contains a large binary + install tree.
dev/owntone/
dev/owntone-src/

# AirPlayEngine (Phase 2, T-PKG-1) SwiftPM build artifacts only — the
# vendored + shimmed sources under AirPlayEngine/Sources/ are NOT ignored.
AirPlayEngine/.build/
AirPlayEngine/.swiftpm/

# Minimal audio-only ffmpeg (ALAC encoder + swresample), a GENERATED build
# artifact produced by scripts/build-min-ffmpeg.sh — arch/version-specific and
# multi-MB, so it is rebuilt on the build machine rather than committed. When
# absent, AirPlayEngine/Package.swift falls back to Homebrew's fat ffmpeg.
AirPlayEngine/vendor/

# SwiftPM build artifacts for the other local packages (same reasoning).
AudiouterCore/.build/
AudiouterProtocol/.build/
AudiouterCore/.swiftpm/
dev/audiocap/.build/
dev/audiocap/.swiftpm/

# Xcode / SwiftPM local state, in case anyone opens this via Xcode.
xcuserdata/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
.swiftpm/xcode/
*.xcuserstate

# iOS app (ios/AudiouterRemote) build artifacts — DerivedData defaults to
# ~/Library/Developer/Xcode/DerivedData, but xcodebuild can be pointed at an
# in-tree build dir with -derivedDataPath; ignore that case too.
ios/DerivedData/
ios/**/DerivedData/

# Impeccable design-skill scratch state (local config + generated critique notes).
.impeccable/

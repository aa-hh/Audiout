+    /// Of two streaming speakers, the one the user deselects while the apply's
+    /// teardown is in flight must stay off, while the other comes back: the
+    /// re-add pass skips only the deselected one, and the result counts the
+    /// survivor alone.
+    /// Turns red if convergeToTarget(on: true) stops checking expectedSelected before it writes desiredOn.
+    @Test func applyStartBufferDoesNotReaddASpeakerDeselectedMidApply() async {
+        let (backend, engine, discovery) = makeBackend()
+        let a = ap2Device(id: "AA:BB:CC:DD:EE:01", name: "Kitchen")
+        let b = ap2Device(id: "AA:BB:CC:DD:EE:02", name: "Lounge")
+
+        backend.start(); defer { backend.stop() }
+        await waitUntilStarted(engine)
+        _ = await collect(from: backend) { events in
+            events.filter { if case .deviceAdded = $0 { return true } else { return false } }.count >= 2
+        } after: {
+            discovery.fire(.appeared(a))
+            discovery.fire(.appeared(b))
+        }
+
+        backend.setOutputSet([a.id, b.id])
+        await pollUntil {
+            let devs = backend.devices
+            return devs.first { $0.id == a.id }?.isSelected == true
+                && devs.first { $0.id == b.id }?.isSelected == true
+        }
+        await pollUntil { !backend.test_isConverging }
+
+        let baseline = engine.ops.count
+        let hold = HoldPoint()
+        engine.onRemoveOutputBody = { id in
+            if id == a.outputID { await hold.hold() }
+        }
+
+        let apply = Task { await backend.applyStartBuffer(ms: 1500) }
+        await pollUntil { hold.entered }
+        backend.setOutputSet([b.id])
+        hold.open()
+        let result = await apply.value
+
+        let ops = Array(engine.ops.dropFirst(baseline))
+        #expect(ops.contains("setBuffer:1500"), "the buffer set still happens; ops: \(ops)")
+        #expect(ops.contains("add:\(b.outputID.rawValue)"),
+                "the still-selected speaker is re-added; ops: \(ops)")
+        #expect(!ops.contains("add:\(a.outputID.rawValue)"),
+                "a speaker deselected mid-apply must not be re-added; ops: \(ops)")
+        let devs = backend.devices
+        #expect(devs.first { $0.id == a.id }?.isSelected == false)
+        #expect(devs.first { $0.id == b.id }?.isSelected == true)
+        #expect(backend.test_expectedSelected == [b.id])
+        #expect(result.reconnected == 1)
+        #expect(result.expected == 1)
+    }
+

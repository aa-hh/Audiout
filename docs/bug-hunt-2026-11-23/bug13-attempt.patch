+    /// A rebuild while the user has paused finds a tap that already stopped
+    /// delivering (it stays idle until an app plays), so the rebuild left no hole.
+    /// Filling against the last pre-pause buffer would push every block after the
+    /// resume late by the whole pause.
+    /// Turns red if `recreateTap` arms the feed-gap fill while the last delivered
+    /// block ended more than 50 ms before the claim.
+    @Test func aRebuildWhileTheTapIsIdleFillsNothing() {
+        let tap = FeedbackFakeTap()
+        let engineSink = SpyPCMSink()
+
+        let coordinator = NativeCaptureCoordinator(
+            makeTap: { tap },
+            sink: engineSink,
+            makeConverter: { _ in FixedConverter() },
+            processResolver: AudioProcessResolver(enumerator: ScriptedEnumerator(pids: [sinkRenderPID])),
+            muteBehavior: .mutedWhenTapped,
+            monotonicNow: { 1_300_000_000 })
+        defer { coordinator.stop() }
+        coordinator.start()
+        waitForCapturing(coordinator)
+
+        tap.deliverMix(frames: 4, phaseStart: 0, pts: timespec(tv_sec: 1, tv_nsec: 0))
+        waitFor { engineSink.forwarded.count == 1 }
+
+        // The claim reads 1.3 s, ~300 ms after buffer 1 ended: the tap was idle.
+        coordinator.updateRouting(appRoutes: [], excludedBundleIDs: ["com.example.x"])
+        waitFor { tap.creates == 2 }
+        waitForCapturing(coordinator)
+
+        // 1.5 s after buffer 1 — inside the 2 s rebuild fill cap, so an arm
+        // standing here would inject ~66 000 frames of silence.
+        tap.deliverMix(frames: 4, phaseStart: 4, pts: timespec(tv_sec: 2, tv_nsec: 500_000_000))
+        waitFor {
+            engineSink.forwarded.count >= 2 && engineSink.forwarded.last?.pcm == FixedConverter.payload
+        }
+
+        let forwarded = engineSink.forwarded
+        #expect(forwarded.count == 2, "a rebuild during a pause must not fill the pause")
+        #expect(forwarded.allSatisfy { $0.pcm == FixedConverter.payload })
+    }
+
+    /// The idle check must not cost a delivering tap its fill: a rebuild claimed
+    /// while audio is still arriving leaves a real hole in the sender's count.
+    /// Turns red if the idle check in `recreateTap` skips the arm for a tap whose
+    /// last block ended within 50 ms of the claim.
+    @Test func aRebuildWhileTheTapIsDeliveringStillFillsItsHole() {
+        let tap = FeedbackFakeTap()
+        let engineSink = SpyPCMSink()
+
+        let coordinator = NativeCaptureCoordinator(
+            makeTap: { tap },
+            sink: engineSink,
+            makeConverter: { _ in FixedConverter() },
+            processResolver: AudioProcessResolver(enumerator: ScriptedEnumerator(pids: [sinkRenderPID])),
+            muteBehavior: .mutedWhenTapped,
+            monotonicNow: { 1_010_000_000 })
+        defer { coordinator.stop() }
+        coordinator.start()
+        waitForCapturing(coordinator)
+
+        tap.deliverMix(frames: 4, phaseStart: 0, pts: timespec(tv_sec: 1, tv_nsec: 0))
+        waitFor { engineSink.forwarded.count == 1 }
+
+        // The claim reads 1.01 s, ~10 ms after buffer 1 ended: still delivering.
+        coordinator.updateRouting(appRoutes: [], excludedBundleIDs: ["com.example.x"])
+        waitFor { tap.creates == 2 }
+        waitForCapturing(coordinator)
+
+        tap.deliverMix(frames: 4, phaseStart: 4, pts: timespec(tv_sec: 1, tv_nsec: 500_000_000))
+        waitFor { engineSink.forwarded.last?.pcm == FixedConverter.payload
+                  && engineSink.forwarded.count > 2 }
+
+        let bytesPerFrame = PCMFormat.airplay.channels * MemoryLayout<Int16>.size
+        let fill = Array(engineSink.forwarded.dropFirst().dropLast())
+        #expect(fill.allSatisfy { $0.pcm.allSatisfy { $0 == 0 } }, "the fill is S16LE silence")
+        let fillFrames = fill.reduce(0) { $0 + $1.pcm.count / bytesPerFrame }
+        // round((0.5 s − 4/44100 s) × 44100).
+        #expect(fillFrames == 22_046, "a delivering tap's rebuild hole is filled exactly")
+    }
+
+    /// Two rebuilds back to back, the second claimed after the tap has gone quiet:
+    /// the first rebuild's hole is still real and still unconsumed.
+    /// Turns red if an idle claim in `recreateTap` disarms the tracker instead of
+    /// leaving an earlier rebuild's arm standing.
+    @Test func aSecondRebuildBeforeAnyBufferKeepsTheFirstRebuildsFill() {
+        final class ClockHolder: @unchecked Sendable {
+            private let lock = NSLock()
+            private var nanos: Int64 = 1_010_000_000
+            var now: Int64 {
+                get { lock.withLock { nanos } }
+                set { lock.withLock { nanos = newValue } }
+            }
+        }
+        let clock = ClockHolder()
+        let tap = FeedbackFakeTap()
+        let engineSink = SpyPCMSink()
+
+        let coordinator = NativeCaptureCoordinator(
+            makeTap: { tap },
+            sink: engineSink,
+            makeConverter: { _ in FixedConverter() },
+            processResolver: AudioProcessResolver(enumerator: ScriptedEnumerator(pids: [sinkRenderPID])),
+            muteBehavior: .mutedWhenTapped,
+            monotonicNow: { clock.now })
+        defer { coordinator.stop() }
+        coordinator.start()
+        waitForCapturing(coordinator)
+
+        tap.deliverMix(frames: 4, phaseStart: 0, pts: timespec(tv_sec: 1, tv_nsec: 0))
+        waitFor { engineSink.forwarded.count == 1 }
+
+        // Rebuild 1 claims while the tap is delivering: armed.
+        coordinator.updateRouting(appRoutes: [], excludedBundleIDs: ["com.example.x"])
+        waitFor { tap.creates == 2 }
+        waitForCapturing(coordinator)
+
+        // Rebuild 2 claims ~300 ms after buffer 1 ended, before any buffer
+        // consumed rebuild 1's arm: idle, so it must leave that arm alone.
+        clock.now = 1_300_000_000
+        coordinator.updateRouting(appRoutes: [], excludedBundleIDs: ["com.example.x", "com.example.y"])
+        waitFor { tap.creates == 3 }
+        waitForCapturing(coordinator)
+
+        tap.deliverMix(frames: 4, phaseStart: 4, pts: timespec(tv_sec: 1, tv_nsec: 500_000_000))
+        waitFor { engineSink.forwarded.last?.pcm == FixedConverter.payload
+                  && engineSink.forwarded.count > 2 }
+
+        let bytesPerFrame = PCMFormat.airplay.channels * MemoryLayout<Int16>.size
+        let fill = Array(engineSink.forwarded.dropFirst().dropLast())
+        #expect(fill.allSatisfy { $0.pcm.allSatisfy { $0 == 0 } }, "the fill is S16LE silence")
+        let fillFrames = fill.reduce(0) { $0 + $1.pcm.count / bytesPerFrame }
+        // round((0.5 s − 4/44100 s) × 44100) — rebuild 1's hole, still filled.
+        #expect(fillFrames == 22_046, "an idle second claim must not drop the first rebuild's fill")
+    }
+
